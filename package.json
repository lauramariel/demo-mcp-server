{
  "name": "demo-crm-mcp-server",
  "version": "1.0.0",
  "description": "Demo MCP server exposing read and write tools over a small CRM (companies, contacts, deals, activities) backed by SQLite.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "demo-crm-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:http": "node dist/http.js",
    "dev:http": "tsx src/http.ts",
    "reset-db": "rm -f data/crm.db && tsx -e \"import './src/db.ts'\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2"
  }
}
